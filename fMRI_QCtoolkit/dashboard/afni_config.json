{
  "metrics": {
    "cens_frac":       {"label": "Censor Fraction",           "good": "< 0.15", "bad": ">= 0.2"},
    "cens_mot":        {"label": "Average Censored Motion",   "good": "< 0.1",  "bad": ">= 0.15"},
    "cens_displace":   {"label": "Max Censored Displacement", "good": "< 6",    "bad": ">= 8"},
    "TSNR":            {"label": "TSNR Average",              "good": "> 150"},
    "DF_frac":         {"label": "Final DF Fraction",         "good": "> 0.7",  "bad": "<= 0.6"},
    "flip_guess":      {"label": "Flip Guess",                                  "bad": "!= 0",    "step": 1},
    "GCOR":            {"label": "GCOR",                      "good": "< 0.15", "bad": ">= 0.2"},
    "frac_TRs_cens_*": {"label": "Fraction TRs Censored",                       "bad": ">= 0.2"}
  },
  "autorate": {
    "metrics": {
      "cens_frac":       {"tolerance": 0.1,   "veto": true},
      "cens_mot":        {"tolerance": "10%", "veto": true},
      "cens_displace":   {"tolerance": "10%", "veto": true},
      "TSNR":            {"tolerance": "10%"},
      "DF_frac":         {"tolerance": 0.1},
      "flip_guess":      {                    "veto": true},
      "GCOR":            {"tolerance": "10%"},
      "frac_TRs_cens_*": {"tolerance": 0.1,   "veto": true}
    },
    "mot": "cens_frac",
    "warns": {"metric": "cens_frac", "good": "< 0.2", "bad": ">= 0.5"},
    "weights": {"vorig": 0.5, "ve2a": 0.5, "va2t": 0.5, "vstat": 2, "mot": 2, "regr": 1, "radcor": 1, "warns": 1, "qsumm": 2},
    "veto_sections": ["mot"],
    "cutoffs": {"bad": 10.5, "other": 5},
    "margin": 3,
    "lenient": false,
    "spot_check": 0.1,
    "calibration": {"min_runs": 30, "min_good": 3}
  }
}
